{
  "name": "pi-ghostty-branches",
  "version": "0.2.0",
  "type": "module",
  "description": "Ghostty-native parallel session branches, navigation, and context folding for Pi.",
  "author": "James Nixon",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "ghostty",
    "session-branching",
    "terminal"
  ],
  "pi": {
    "extensions": [
      "./extensions/ghostty-branches/index.ts"
    ]
  },
  "files": [
    "extensions/ghostty-branches",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.0",
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "@earendil-works/pi-tui": ">=0.84.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "node --check extensions/ghostty-branches/sidebar.mjs && node --experimental-strip-types --test tests/*.test.mjs"
  }
}
